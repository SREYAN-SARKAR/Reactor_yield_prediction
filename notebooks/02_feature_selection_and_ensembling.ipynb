    # ... (candidates dict continues with ExtraTrees, GradientBoosting, HistGradientBoosting, Gaussian Process) ...
    "ExtraTrees": make_pipe(ExtraTreesRegressor(n_estimators=500, random_state=RANDOM_STATE, n_jobs=-1)),
    "GradientBoosting": make_pipe(GradientBoostingRegressor(n_estimators=300, learning_rate=0.05,
                                                            max_depth=3, subsample=0.9, random_state=RANDOM_STATE)),
    "HistGradientBoosting": make_pipe(HistGradientBoostingRegressor(max_iter=400, learning_rate=0.08,
                                                                    max_depth=4, random_state=RANDOM_STATE)),
    "Gaussian Process": make_pipe(GaussianProcessRegressor(kernel=gpr_kernel, normalize_y=True,
                                                           n_restarts_optimizer=3, random_state=RANDOM_STATE), scale=True),
}
print("Number of candidate models:", len(candidates))

rows = []
for name, model in candidates.items():
    mean_rmse, std_rmse = cv_rmse(model)
    rows.append({"Model": name, "CV RMSE Mean": mean_rmse, "CV RMSE Std": std_rmse})
comparison = pd.DataFrame(rows).sort_values("CV RMSE Mean").reset_index(drop=True)
display(comparison)

# --- Hyperparameter tuning (GradientBoosting / ExtraTrees / RandomForest) ---
search_spaces = {
    "GradientBoosting": (make_pipe(GradientBoostingRegressor(random_state=RANDOM_STATE)), {
        "model__n_estimators": [200, 300, 500, 800],
        "model__learning_rate": [0.02, 0.03, 0.05, 0.08],
        "model__max_depth": [2, 3, 4],
        "model__subsample": [0.7, 0.8, 0.9, 1.0],
        "model__min_samples_leaf": [1, 2, 3],
    }),
    "ExtraTrees": (make_pipe(ExtraTreesRegressor(random_state=RANDOM_STATE, n_jobs=-1)), {
        "model__n_estimators": [300, 500, 800],
        "model__max_depth": [None, 8, 12, 20],
        "model__max_features": [0.5, 0.6, 0.8, 1.0],
        "model__min_samples_leaf": [1, 2, 3],
    }),
    "RandomForest": (make_pipe(RandomForestRegressor(random_state=RANDOM_STATE, n_jobs=-1)), {
        "model__n_estimators": [300, 500, 800],
        "model__max_depth": [None, 6, 8, 12],
        "model__max_features": [0.4, 0.5, 0.6, 0.8],
        "model__min_samples_leaf": [1, 2, 3],
    }),
}

tuned = {}
for name, (model_pipeline, parameter_space) in search_spaces.items():
    search = RandomizedSearchCV(estimator=model_pipeline, param_distributions=parameter_space,
                                n_iter=25, cv=cv_repeated, scoring="neg_root_mean_squared_error",
                                random_state=RANDOM_STATE, n_jobs=-1)
    search.fit(X, y)
    tuned[f"{name} (tuned)"] = search.best_estimator_
    print(f"{name} Tuning Complete | Best CV RMSE: {-search.best_score_:.4f} | {search.best_params_}")

# --- Individual model leaderboard ---
pool = {**candidates, **tuned}
individual_scores = {name: cv_rmse(model) for name, model in pool.items()}
individual_leaderboard = (pd.DataFrame([{"Model": n, "CV RMSE Mean": r[0], "CV RMSE Std": r[1]}
                                        for n, r in individual_scores.items()])
                           .sort_values("CV RMSE Mean").reset_index(drop=True))
display(individual_leaderboard)

# --- Ensembling: wide weight grid + stacking ---
top_3_names = individual_leaderboard["Model"].head(3).tolist()
top_3_models = [(name.replace(" ", "_"), pool[name]) for name in top_3_names]

weight_sets = [(1,1,1),(2,1,1),(1,2,1),(1,1,2),(2,2,1),(2,1,2),(1,2,2),(3,2,1),(3,1,2),(4,2,1),(5,3,2)]

ens = {
    "Voting (top 2)": VotingRegressor(estimators=top_3_models[:2]),
    "Voting (top 3 equal)": VotingRegressor(estimators=top_3_models),
    "Stacking (Ridge meta)": StackingRegressor(estimators=top_3_models, final_estimator=Ridge(alpha=1.0),
                                               cv=cv_5, n_jobs=-1),
}
for weights in weight_sets:
    ens[f"Voting Weights {weights}"] = VotingRegressor(estimators=top_3_models, weights=weights)

ensemble_leaderboard = (pd.DataFrame([{"Model": n, "CV RMSE Mean": cv_rmse(m)[0], "CV RMSE Std": cv_rmse(m)[1]}
                                      for n, m in ens.items()])
                         .sort_values("CV RMSE Mean").reset_index(drop=True))
display(ensemble_leaderboard)

# --- Final selection across individuals + ensembles ---
all_models = {**pool, **ens}
scores = {name: cv_rmse(model) for name, model in all_models.items()}
leaderboard = (pd.DataFrame([{"Model": n, "CV RMSE Mean": r[0], "CV RMSE Std": r[1]} for n, r in scores.items()])
               .sort_values("CV RMSE Mean").reset_index(drop=True))
display(leaderboard)

best_name = leaderboard.iloc[0]["Model"]
best_model = all_models[best_name]
best_mean, best_std = scores[best_name]
print("Selected Model:", best_name, "| Best CV RMSE:", f"{best_mean:.4f}", "| Std:", f"{best_std:.4f}")

# --- Multi-seed stability check ---
final_candidates = {
    "Best Individual": pool[individual_leaderboard.iloc[0]["Model"]],
    "Best Ensemble": ens[ensemble_leaderboard.iloc[0]["Model"]],
    "Overall Winner": best_model,
}
seeds = [42, 123, 456, 789, 2026]
stability_results = []
for model_name, model in final_candidates.items():
    for seed in seeds:
        cv_test = RepeatedKFold(n_splits=5, n_repeats=3, random_state=seed)
        scores_seed = -cross_val_score(model, X, y, cv=cv_test, scoring="neg_root_mean_squared_error", n_jobs=-1)
        stability_results.append({"Model": model_name, "Seed": seed,
                                   "RMSE Mean": scores_seed.mean(), "RMSE Std": scores_seed.std()})

stability_summary = (pd.DataFrame(stability_results).groupby("Model")
                      .agg(Average_RMSE=("RMSE Mean", "mean"), Stability=("RMSE Mean", "std"),
                           Best_RMSE=("RMSE Mean", "min"), Worst_RMSE=("RMSE Mean", "max"))
                      .sort_values("Average_RMSE"))
display(stability_summary)

# --- Final fit, predict, save ---
best_model.fit(X, y)
preds = best_model.predict(X_test)
preds = np.clip(preds, 0.0, 100.0).astype(float).round(3)
assert len(preds) == len(test), "Prediction count does not match test rows"

submission = pd.DataFrame({"overall_yield": preds})
submission.to_csv("../outputs/submission_optimized.csv", index=False)
print("Submission shape:", submission.shape)
display(submission)
